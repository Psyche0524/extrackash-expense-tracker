# Copy these names to your server's environment when deploying. Development needs none of them.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.example.com

# Real email for password reset links (optional; without these, links print in the server terminal)
EMAIL_HOST_USER=your-app-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Extrackash <your-app-email@gmail.com>
